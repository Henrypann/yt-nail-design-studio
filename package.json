{
  "name": "nail-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:shape-types": "node tools/generate-shape-types.mjs",
    "build": "tsc -b && vite build",
    "build:integration": "tsc -b && vite build --mode integration",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test:community-content": "node tools/validate-community-content.mjs",
    "test:community-taxonomy": "node tools/validate-community-taxonomy.mjs",
    "test:community-official": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/validate-community-official.mjs",
    "test:community-domain": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-community-domain.mjs",
    "test:community-intent": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-community-intent.mjs",
    "test:community-studio-flow": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-community-studio-flow.mjs",
    "slot-calibrator": "npx --yes serve -p 7788 .",
    "test:slots": "node tools/slot-calibrator/test-slot-math.mjs",
    "test:slot-coverage": "node tools/test-slot-coverage.mjs",
    "check:slot-coverage": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/check-slot-coverage.mjs",
    "test:mirror": "node tools/test-handdraw.mjs",
    "test:render-brush": "node tools/test-handdraw.mjs",
    "requirements:audit": "node --experimental-strip-types tools/audit-page-requirements.mjs",
    "requirements:refresh": "node --experimental-strip-types tools/audit-page-requirements.mjs --refresh",
    "validate-assets": "python3 tools/validate-assets.py",
    "validate-recipes": "node tools/validate-recipes.mjs",
    "generate:mercury-fixtures": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/generate-mercury-fixtures.mjs",
    "test:recipe-schema": "node --experimental-strip-types src/studio/editor/lib/recipe-schema.selftest.ts",
    "test:recipe-migrate": "node --experimental-strip-types src/studio/editor/lib/recipe-migrate.selftest.ts",
    "test:surface-mapper": "node --experimental-strip-types src/studio/editor/lib/surface-mapper.selftest.ts",
    "test:mercury-fixtures": "node tools/validate-mercury-fixtures.mjs",
    "test:petal-veil": "node tools/validate-petal-veil.mjs",
    "test:recipe-output": "node --experimental-strip-types src/studio/editor/lib/recipe-output.selftest.ts",
    "test:taxonomy-enums": "node --experimental-strip-types src/studio/editor/lib/taxonomy-enums.selftest.ts",
    "test:handdraw": "node tools/test-handdraw.mjs && node --experimental-strip-types src/studio/finger-display.selftest.ts && node --experimental-strip-types src/studio/editor/lib/french-edge.selftest.ts && node --experimental-strip-types src/studio/editor/lib/mirror.selftest.ts && node --experimental-strip-types src/studio/editor/lib/migrate.selftest.ts && node --experimental-strip-types src/studio/editor/lib/recipes.selftest.ts",
    "dogfood:walkthrough": "node tools/review-walkthrough.mjs",
    "dogfood:mock-scenarios": "node tools/review-mock-scenarios.mjs",
    "dogfood:creator-path": "node tools/review-creator-path.mjs",
    "dogfood:single-degrade": "node tools/review-single-degrade.mjs",
    "dogfood:final-shots": "node tools/final-shots.mjs",
    "dogfood:verify-render-fail-toast": "node tools/verify-render-fail-toast.mjs",
    "test:editor-v6-contract": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v6-contract.mjs",
    "test:editor-v7-contract": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v7-contract.mjs",
    "test:editor-v7-migrate": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v7-migrate.mjs",
    "test:editor-v7-runtime": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v7-runtime.mjs",
    "test:editor-v7-workspace": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v7-workspace.mjs",
    "test:editor-v7-workspace-ia": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v7-workspace-ia.mjs",
    "test:editor-v7-customer-preview": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v7-customer-preview.mjs",
    "test:editor-v7-background": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v7-background.mjs",
    "test:editor-v7-background-advanced": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v7-background-advanced.mjs",
    "test:editor-v7-flat-vector": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v7-flat-vector.mjs",
    "test:editor-v6-migrate": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v6-migrate.mjs",
    "test:store-v6": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-store-v6.mjs",
    "test:editor-v6-runtime": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-editor-v6-runtime.mjs",
    "test:pr04-editor-entry": "node tools/test-pr04-editor-entry.mjs",
    "test:pr05": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-pr05-wizard-v6.mjs && npm run test:pr05-recommendations && npm run test:pr05-wizard-draft && npm run test:pr05-v6-bridge",
    "test:pr05-recommendations": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-pr05-recommendations.mjs",
    "test:pr05-wizard-draft": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-pr05-wizard-draft-intent.mjs",
    "test:pr05-v6-bridge": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-pr05-v6-bridge.mjs",
    "test:pr06": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-pr06-3d.mjs",
    "test:pr06-bundle": "node tools/test-pr06-bundle.mjs",
    "test:pr07": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-pr07-editor-v6.mjs",
    "test:pr08": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-pr08-taxonomy.mjs",
    "test:pr09": "node --import ./tools/lib/register-node-vite.mjs --experimental-strip-types tools/test-pr09-brand.mjs"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.185.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
