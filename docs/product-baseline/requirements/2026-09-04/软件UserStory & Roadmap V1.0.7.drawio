        <mxCell id="nYCefA4Zr1cWTN-4DUCK-12" parent="1" style="swimlane;childLayout=stackLayout;horizontal=1;startSize=50;horizontalStack=0;rounded=1;fontSize=14;fontStyle=0;strokeWidth=2;resizeParent=0;resizeLast=1;shadow=0;dashed=0;align=center;arcSize=4;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;font-size: 12px; font-weight: 700;&quot;&gt;FP01：用户等级设计&lt;/span&gt;" vertex="1">
