{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextgen.beauty/schema/geometry-registry-v2.schema.json",
  "title": "NextGen Beauty Geometry Registry V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registryId", "revision", "geometryContractVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "registryId": { "const": "nextgen-beauty.geometry-registry-v2" },
    "revision": { "type": "string", "minLength": 1 },
    "geometryContractVersion": { "const": "1.0.0" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "bundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "sha256", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "revision": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "path": { "type": "string", "pattern": "^assets/.+\\.json$" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryEntryId", "revision", "shape", "length", "promotionState", "promotionClass", "bundleRef", "surfaceDefinitionRef", "geometrySnapshotRef", "representationSetRef", "browserDelivery", "policy", "evidence"],
      "properties": {
        "registryEntryId": { "type": "string", "minLength": 3 },
        "revision": { "type": "string", "minLength": 1 },
        "shape": { "const": "almond" },
        "length": { "const": "medium" },
        "promotionState": { "const": "promoted_simulated_preview" },
        "promotionClass": { "const": "simulated_preview_geometry_kernel" },
        "bundleRef": { "$ref": "#/$defs/bundleRef" },
        "surfaceDefinitionRef": { "$ref": "#/$defs/ref" },
        "geometrySnapshotRef": { "$ref": "#/$defs/ref" },
        "representationSetRef": { "$ref": "#/$defs/ref" },
        "browserDelivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["representationId", "revision", "runtimeUrl", "mimeType", "sha256", "byteLength", "triangleCount"],
          "properties": {
            "representationId": { "type": "string" },
            "revision": { "type": "string" },
            "runtimeUrl": { "type": "string", "pattern": "^/geometry-v0-7-2/.+\\.glb$" },
            "mimeType": { "const": "model/gltf-binary" },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "byteLength": { "type": "integer", "minimum": 1 },
            "triangleCount": { "type": "integer", "minimum": 1 }
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fidelity", "allowedConsumers", "forbiddenConsumers", "writerEffect"],
          "properties": {
            "fidelity": { "const": "approximate" },
            "allowedConsumers": { "const": ["single_nail_pbr", "geometry_kernel_preview"] },
            "forbiddenConsumers": { "const": ["manufacturing_compiler", "device_job", "production_export"] },
            "writerEffect": { "const": "none" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["productVisualSignoff", "representationParityVerified", "bundleIntegrityVerified", "manufacturingValidated", "promotedAt", "validationRefs", "limitations"],
          "properties": {
            "productVisualSignoff": { "const": "PRODUCT_VISUAL_SIGNED_OFF" },
            "representationParityVerified": { "const": true },
            "bundleIntegrityVerified": { "const": true },
            "manufacturingValidated": { "const": false },
            "promotedAt": { "type": "string", "format": "date-time" },
            "validationRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
